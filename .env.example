NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Basic auth: 両方設定した場合のみ有効
BASIC_AUTH_ID=
BASIC_AUTH_PASSWORD=

# Contentful: https://contentful.com/
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_ACCESS_TOKEN=
CONTENTFUL_PREVIEW_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master
# Contact inquiry save via Contentful Management API
CONTENTFUL_MANAGEMENT_TOKEN=

# Resend: https://resend.com/
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@example.com
# Set this to your Gmail address to receive inquiry notifications
CONTACT_TO_EMAIL=your-gmail@gmail.com

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 省略時は gemini-2.0-flash（利用可能なモデル名に合わせて変更）
GEMINI_MODEL=

# Octopus Energy (Kraken GraphQL). UK: https://api.octopus.energy/v1/graphql/ — Japan (OEJP): https://api.oejp-kraken.energy/v1/graphql/
# JWT access token or account API key; refresh token extends sessions when the JWT expires.
OCTOPUSENERGY_API_KEY=
OCTOPUSENERGY_REFRESH_TOKEN=
# Optional: override auto-detected GraphQL URL (from JWT iss)
# OCTOPUSENERGY_GRAPHQL_URL=https://api.oejp-kraken.energy/v1/graphql/
# Optional: defaults to the first account on the viewer
# OCTOPUSENERGY_ACCOUNT_NUMBER=
# Optional: calendar day for "today" usage (default Asia/Tokyo, matches site clock)
# OCTOPUSENERGY_TIMEZONE=Asia/Tokyo
