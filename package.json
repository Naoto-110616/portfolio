{
	"name": "portfolio",
	"version": "1.0.0",
	"private": true,
	"description": "Personal portfolio site built with Next.js, Contentful, Resend, and TanStack Query.",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"fix": "eslint . --fix && prettier --write .",
		"typecheck": "tsc --noEmit",
		"contentful:migrate": "tsx contentful/scripts/migrate.ts --yes"
	},
	"keywords": [
		"portfolio",
		"nextjs",
		"contentful",
		"resend",
		"tanstack-query"
	],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@google/generative-ai": "^0.24.1",
		"@tanstack/react-query": "^5.90.21",
		"contentful": "^11.10.7",
		"contentful-management": "^12.2.0",
		"gsap": "^3.14.2",
		"lenis": "^1.3.21",
		"lucide-react": "^1.7.0",
		"motion": "^12.38.0",
		"next": "^16.1.7",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"resend": "^6.9.4",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@playwright/test": "^1.59.1",
		"@tailwindcss/postcss": "^4.2.1",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"contentful-migration": "^4.32.0",
		"eslint": "^9.39.4",
		"eslint-config-next": "^16.1.7",
		"prettier": "^3.8.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4.2.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.5"
	}
}
